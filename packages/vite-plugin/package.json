{
  "name": "@sebas-dv/shadcn-theme-editor-vite",
  "version": "0.1.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Vite plugin that mounts the shadcn theme-editor API and injects the live overlay. Covers Vite, Laravel+Inertia, TanStack Start, Astro, Remix, SvelteKit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebas-DV/shadcn-theme-editor.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/Sebas-DV/shadcn-theme-editor/issues"
  },
  "homepage": "https://github.com/Sebas-DV/shadcn-theme-editor#readme",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "vite",
    "vite-plugin",
    "theme-editor",
    "tailwind-v4",
    "oklch",
    "laravel-inertia",
    "astro",
    "remix"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sebas-dv/shadcn-theme-editor-overlay": "workspace:*",
    "@sebas-dv/shadcn-theme-editor-server": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "vite": "^8.2.2"
  }
}
