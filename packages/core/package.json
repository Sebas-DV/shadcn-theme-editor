{
  "name": "@sebas-dv/shadcn-theme-editor-core",
  "version": "0.1.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Framework-agnostic engine: parse, categorize and rewrite shadcn (Tailwind v4) theme tokens with PostCSS while preserving OKLCH formatting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebas-DV/shadcn-theme-editor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Sebas-DV/shadcn-theme-editor/issues"
  },
  "homepage": "https://github.com/Sebas-DV/shadcn-theme-editor#readme",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "oklch",
    "color",
    "contrast",
    "wcag",
    "postcss",
    "theme",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postcss": "^8.5.28",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.5.0",
    "culori": "^4.0.2"
  }
}
