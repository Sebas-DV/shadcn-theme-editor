{
  "name": "shadcn-theme-editor-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "In-app overlay to edit shadcn (Tailwind v4) theme tokens live and write them back to the source CSS. Framework-agnostic (Vite plugin + React drop-in for Next.js).",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./cli\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" --filter \"./cli\" run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test",
    "clean": "pnpm -r exec rimraf dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8"
  }
}
